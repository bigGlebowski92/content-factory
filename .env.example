# Content Factory Configuration

# Model Provider
# true  = mock (без ключей, для тестов)
# false = реальный API (по умолчанию OpenAI)
USE_MOCK_PROVIDER=true
MODEL_PROVIDER=openai

# OpenAI API Key (нужен если USE_MOCK_PROVIDER=false и MODEL_PROVIDER=openai)
# НИКОГДА не коммитьте этот файл с настоящим ключом
OPENAI_API_KEY=

# Anthropic (опционально, если MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Stage 2: Telegram
# Оставьте USE_MOCK_TELEGRAM=true для локальной разработки
USE_MOCK_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@content_factory_test
DEFAULT_LANDING_URL=https://example.com

# Stage 3: website/platform + short links
USE_MOCK_PLATFORM=true
PLATFORM_API_URL=
PLATFORM_API_KEY=
SHORT_LINK_BASE_URL=https://go.example.com

# Model Selection (роли пайплайна; для OpenAI мапятся на gpt-4o-mini / gpt-4o)
PLANNER_MODEL=haiku-4.5
RESEARCHER_MODEL=sonnet-5
GENERATOR_MODEL=opus-5
AUDITOR_MODEL=sonnet-5

# Quality Control
MAX_REVISION_ROUNDS=2
AUDIT_PASS_THRESHOLD=0.7

# Spending Limits (USD)
DAILY_SPEND_LIMIT_USD=50.0
MONTHLY_SPEND_LIMIT_USD=500.0

# Storage
DATABASE_PATH=data/content_factory.db
CONFIG_DIR=config
