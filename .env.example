# Content Factory Configuration

# Model Provider
# Set to false to use real Anthropic API
USE_MOCK_PROVIDER=true

# Anthropic API Key (required if USE_MOCK_PROVIDER=false)
# NEVER commit this file with a real key
ANTHROPIC_API_KEY=

# Stage 2: Telegram
# Keep USE_MOCK_TELEGRAM=true for local/dev (no real bot calls)
USE_MOCK_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@content_factory_test
DEFAULT_LANDING_URL=https://example.com

# Stage 3: website/platform + short links
USE_MOCK_PLATFORM=true
PLATFORM_API_URL=
PLATFORM_API_KEY=
SHORT_LINK_BASE_URL=https://go.example.com

# Model Selection
PLANNER_MODEL=haiku-4.5
RESEARCHER_MODEL=sonnet-5
GENERATOR_MODEL=opus-5
AUDITOR_MODEL=sonnet-5

# Quality Control
MAX_REVISION_ROUNDS=2
AUDIT_PASS_THRESHOLD=0.7

# Spending Limits (USD)
DAILY_SPEND_LIMIT_USD=10.0
MONTHLY_SPEND_LIMIT_USD=300.0

# Storage
DATABASE_PATH=data/content_factory.db
CONFIG_DIR=config
